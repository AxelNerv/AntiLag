<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>latest</LangVersion>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Строгий анализ: ошибками считаем всё, что может реально сломаться
         (культура чисел, утечка ресурсов, проигнорированный результат вызова).
         Чисто стилистические правила отключены осознанно:
         CA1822  - «метод можно сделать static»: у сервисов это часть их API;
         CA1838  - StringBuilder в P/Invoke: читаемее буфера, вызовов единицы;
         CA1859  - возврат конкретного типа кисти вместо Brush: выигрыш незаметен;
         CA1720  - «имя содержит имя типа»;
         CA2249  - IndexOf вместо Contains: там сравнение с учётом культуры. -->
    <NoWarn>CA1822;CA1838;CA1859;CA1720;CA2249</NoWarn>
    <AssemblyName>AntiLag</AssemblyName>
    <RootNamespace>AntiLagPro.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources\app.ico</ApplicationIcon>
    <Version>0.5.1</Version>
    <AssemblyVersion>0.5.1.0</AssemblyVersion>
    <FileVersion>0.5.1.0</FileVersion>
    <Authors>AxelNerv</Authors>
    <Company>AxelNerv</Company>
    <Product>AntiLag</Product>
    <Copyright>AntiLag — AxelNerv. Создано с Claude Code.</Copyright>
    <Description>AntiLag — оптимизатор задержки и инпут-лага для Windows (автор AxelNerv, создано с Claude Code).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\AntiLagPro.Core\AntiLagPro.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Resources\app.ico" />
    <Resource Include="Resources\tray.ico" />
  </ItemGroup>

  <!-- WinForms добавляет глобальные usings System.Drawing / System.Windows.Forms,
       что конфликтует с WPF (Brush, Color, Application). Убираем их — трей-код
       обращается к WinForms через полные имена. -->
  <ItemGroup>
    <Using Remove="System.Drawing" />
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
