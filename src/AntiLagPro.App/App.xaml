<Application x:Class="AntiLagPro.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <!-- Акцент приложения. Меняется на лету из Настроек (Theme.Apply),
             поэтому во всех стилях используется через DynamicResource.
             AccentFg — цвет текста ПОВЕРХ акцента, подбирается по яркости. -->
        <SolidColorBrush x:Key="Accent" Color="#D4D4D8"/>
        <SolidColorBrush x:Key="AccentFg" Color="#09090B"/>

        <!-- Отступы строки твика: меняются переключателем плотности в Настройках -->
        <Thickness x:Key="RowPad" Left="17" Top="15" Right="17" Bottom="15"/>
    </Application.Resources>
</Application>
