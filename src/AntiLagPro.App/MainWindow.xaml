<Window x:Class="AntiLagPro.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="AntiLag" Height="800" Width="1030" MinWidth="940" MinHeight="640"
        Icon="Resources/app.ico"
        WindowStartupLocation="CenterScreen" WindowStyle="None"
        Background="#FF0B0B0C" Foreground="#FFF5F5F4"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <!-- Своя шапка окна: системную убрали, но перетаскивание, ресайз по краям
         и прилипание к краям экрана оставляет за собой WindowChrome. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- ===== Дизайн-система (по мотивам Wootility): zinc-нейтрали + янтарный акцент =====
             Фон #09090B · карточки #18181B · границы #27272A · акцент настраивается в Настройках (DynamicResource Accent)
             Радиусы: 8 контролы / 12 карточки · Переходы 200ms · Сетка 4px          -->

        <!-- Вторичная кнопка (по умолчанию) -->
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Background" Value="#FF27272A"/>
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" CornerRadius="8"/>
                            <Border x:Name="ov" CornerRadius="8">
                                <Border.Background>
                                    <SolidColorBrush Color="#00FFFFFF"/>
                                </Border.Background>
                            </Border>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ov"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#14FFFFFF" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="ov"
                                                Storyboard.TargetProperty="(Border.Background).(SolidColorBrush.Color)"
                                                To="#00FFFFFF" Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ov" Property="Background" Value="#1F000000"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Главная кнопка: янтарная заливка, тёмный текст (контраст 10:1) -->
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource Accent}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
        </Style>

        <!-- Прозрачная кнопка -->
        <Style x:Key="Ghost" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#00000000"/>
            <Setter Property="Foreground" Value="#FFA1A1AA"/>
        </Style>

        <!-- Кнопки своей шапки окна -->
        <Style x:Key="CaptionButton" TargetType="Button">
            <Setter Property="Width" Value="44"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Foreground" Value="#FF78787E"/>
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF1E1E22"/>
                                <Setter Property="Foreground" Value="#FFF5F5F4"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="CloseButton" TargetType="Button" BasedOn="{StaticResource CaptionButton}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FFC42B1C"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Карточка-блок для разделов-инструментов (Сеть, Оформление) -->
        <Style x:Key="BlockCard" TargetType="Button">
            <Setter Property="Background" Value="#FF161618"/>
            <Setter Property="BorderBrush" Value="#FF232327"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Top"/>
            <Setter Property="Padding" Value="18,18,18,16"/>
            <Setter Property="Margin" Value="0,0,12,12"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="c" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="1" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="c" Property="Background" Value="#FF1A1A1C"/>
                                <Setter TargetName="c" Property="BorderBrush" Value="#FF3D3A2C"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Кнопка «← ВСЕ БЛОКИ» -->
        <Style x:Key="BackPill" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF161618"/>
            <Setter Property="Padding" Value="12,7"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
        </Style>

        <!-- Заголовок группы в боковой панели -->
        <Style x:Key="NavGroupTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FF5A5A60"/>
            <Setter Property="Margin" Value="12,16,12,8"/>
        </Style>

        <!-- Ползунок под тему -->
        <Style x:Key="SliderThumb" TargetType="Thumb">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="18" Height="18" Background="Transparent">
                            <Ellipse x:Name="dot" Width="16" Height="16" Fill="#FFFAFAFA"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="dot" Property="Width" Value="18"/>
                                <Setter TargetName="dot" Property="Height" Value="18"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="Slider">
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Height" Value="20"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="5" CornerRadius="3" Background="#FF27272A" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="5" CornerRadius="3" Background="{DynamicResource Accent}"
                                                        VerticalAlignment="Center"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Образец цвета акцента -->
        <Style x:Key="Swatch" TargetType="Button">
            <Setter Property="Width" Value="42"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="Margin" Value="0,0,10,0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Border CornerRadius="13" BorderThickness="2" BorderBrush="{TemplateBinding BorderBrush}"/>
                            <Border x:Name="fill" Background="{TemplateBinding Background}" CornerRadius="9" Margin="4"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="fill" Property="Margin" Value="2"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок секции -->
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
        </Style>
        <Style x:Key="SectionSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#FFA1A1AA"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>

        <!-- Карточка -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#FF161618"/>
            <Setter Property="BorderBrush" Value="#FF27272A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="18"/>
        </Style>

        <!-- Навигация в боковой панели -->
        <Style x:Key="NavList" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        </Style>
        <Style x:Key="NavItem" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#FF9C9CA3"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Grid Margin="0,1">
                            <Border x:Name="bd" Background="Transparent" Height="36" CornerRadius="8"/>
                            <!-- полоска активного пункта -->
                            <Border x:Name="mark" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                                    Background="{DynamicResource Accent}" Visibility="Collapsed"/>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0">
                                <TextBlock x:Name="ico" Text="{Binding Tag}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="14" Width="16" Foreground="#FF67676E" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                <TextBlock Text="{Binding Header}" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF171719"/>
                                <Setter Property="Foreground" Value="#FFF5F5F4"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="bd" Property="Background" Value="#FF1C1C1F"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="ico" Property="Foreground" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="#FFFFFFFF"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- TabControl с верхней полосой вкладок (используется под-вкладками «Сети») -->
        <Style TargetType="TabControl">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TabPanel Grid.Row="0" IsItemsHost="True" Margin="0,0,0,14"/>
                            <ContentPresenter Grid.Row="1" ContentSource="SelectedContent"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Оболочка: рельса скрыта, навигация живёт в боковой панели -->
        <Style x:Key="ShellTabs" TargetType="TabControl">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <ContentPresenter ContentSource="SelectedContent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Вкладка-пилюля (под-вкладки).
             ВАЖНО: цвет задаём Border'у, а не самому TabItem — иначе содержимое
             вкладки унаследует тёмный «текст на янтаре» и станет нечитаемым. -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="b" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1"
                                CornerRadius="8" Padding="16,8" Margin="0,0,8,0"
                                TextElement.Foreground="#FFA1A1AA">
                            <ContentPresenter ContentSource="Header"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF27272A"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="#FFFAFAFA"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="b" Property="TextElement.Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Сегментированный переключатель (пилюли) -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#FFA1A1AA"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="b" Background="#FF27272A" CornerRadius="7" Padding="14,7" Margin="0,0,6,0">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Background" Value="#FF27272A"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="b" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentFg}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тёмный ComboBox под тему -->
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ci" Background="Transparent" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ci" Property="Background" Value="#FF27272A"/></Trigger>
                            <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ci" Property="Background" Value="{DynamicResource Accent}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Background" Value="#FF09090B"/>
            <Setter Property="BorderBrush" Value="#FF27272A"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid>
                            <Border x:Name="cbd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="6"/>
                            <ToggleButton Focusable="False" ClickMode="Press"
                                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              Margin="10,0,28,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                            <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="9"
                                       Foreground="#FFA1A1AA" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,0" IsHitTestVisible="False"/>
                            <Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                                <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="6" Margin="0,4,0,4"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="280">
                                    <ScrollViewer><ItemsPresenter/></ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="cbd" Property="Background" Value="#FF161618"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Тонкий скроллбар в тон тёмной теме -->
        <Style x:Key="ThinThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="#FF27272A" CornerRadius="4" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ThinThumb}"/>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" Background="Transparent" BorderThickness="0"/>
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" Background="Transparent" BorderThickness="0"/>
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal"/>
                                <Setter Property="Width" Value="Auto"/>
                                <Setter Property="Height" Value="10"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Переключатель-ползунок вместо квадратной галочки -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="track" Width="42" Height="22" CornerRadius="11" Background="#FF27272A">
                                <Border x:Name="knob" Width="16" Height="16" CornerRadius="8" Background="#FFFAFAFA"
                                        HorizontalAlignment="Left" Margin="3,0,0,0">
                                    <Border.RenderTransform>
                                        <TranslateTransform x:Name="knobT" X="0"/>
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <ContentPresenter VerticalAlignment="Center" Margin="9,0,0,0"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobT" Storyboard.TargetProperty="X"
                                                             To="20" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="knobT" Storyboard.TargetProperty="X"
                                                             To="0" Duration="0:0:0.16">
                                                <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                                            </DoubleAnimation>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="knob" Property="Width" Value="18"/>
                                <Setter TargetName="knob" Property="Height" Value="18"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Стиль подсказки (тёмная, скруглённая, с переносом) -->
        <Style TargetType="ToolTip">
            <Setter Property="Background" Value="#FF161618"/>
            <Setter Property="Foreground" Value="#FFFAFAFA"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="11,8"
                                BorderBrush="#FF27272A" BorderThickness="1">
                            <ContentPresenter/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Шаблон находки диагностики -->
        <DataTemplate x:Key="FindingTemplate">
            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8">
                <Grid>
                    <Border Width="4" HorizontalAlignment="Left" Background="{Binding Accent}" CornerRadius="8,0,0,8"/>
                    <Grid Margin="16,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Title}" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Detail}" Foreground="#FFA1A1AA" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            <TextBlock Text="{Binding Fix}" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding FixVisibility}"/>
                        </StackPanel>
                        <Button Grid.Column="1" Content="Открыть →" Tag="{Binding GoTo}" Click="FindingGoTo_Click"
                                VerticalAlignment="Center" Margin="12,0,0,0" Padding="12,6"
                                Visibility="{Binding GoToVisibility}"/>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Строка твика: имя + бейдж + короткая подпись, разворот показывает
             полное описание, ключ реестра и предупреждение -->
        <DataTemplate x:Key="TweakTemplate">
            <Border x:Name="row" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1"
                    CornerRadius="11" Margin="0,0,0,8">
                <StackPanel>
                    <Grid Margin="{DynamicResource RowPad}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Margin="0,0,14,0" Background="Transparent"
                                    MouseLeftButtonUp="TweakExpand_Click" Cursor="Hand">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                           Foreground="#FFF5F5F4" TextWrapping="Wrap"/>
                                <Border Visibility="{Binding TagVisibility}" BorderBrush="#FF3A3117" BorderThickness="1"
                                        CornerRadius="4" Padding="6,2" Margin="9,1,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Foreground="#FFC9A227"/>
                                </Border>
                            </StackPanel>
                            <TextBlock Text="{Binding Summary}" Foreground="#FF78787E" FontSize="12"
                                       Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="1" x:Name="chev" Width="26" Height="26" CornerRadius="6" Cursor="Hand"
                                Background="Transparent" VerticalAlignment="Center" Margin="0,0,12,0"
                                MouseLeftButtonUp="TweakExpand_Click">
                            <TextBlock Text="{Binding Chevron}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                       FontSize="10" Foreground="#FF5A5A60"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>

                        <CheckBox Grid.Column="2" VerticalAlignment="Center"
                                  IsChecked="{Binding IsSelected, Mode=TwoWay}"/>
                    </Grid>

                    <!-- Подробности -->
                    <StackPanel Margin="17,0,17,16" Visibility="{Binding DetailVisibility}">
                        <Border Height="1" Background="#FF232327" Margin="0,0,0,13"/>
                        <TextBlock Text="{Binding Description}" Foreground="#FF9C9CA3" FontSize="12.5"
                                   TextWrapping="Wrap" LineHeight="20" MaxWidth="660" HorizontalAlignment="Left"/>
                        <WrapPanel Margin="0,12,0,0">
                            <Border Background="#FF0F0F11" BorderBrush="#FF232327" BorderThickness="1"
                                    CornerRadius="5" Padding="8,4" Margin="0,0,10,0">
                                <TextBlock Text="{Binding Target}" FontFamily="Consolas, Cascadia Mono"
                                           FontSize="11" Foreground="#FF67676E"/>
                            </Border>
                            <TextBlock Text="{Binding Warning}" Visibility="{Binding WarningVisibility}"
                                       Foreground="#FFC9A227" FontSize="11.5" VerticalAlignment="Center"
                                       TextWrapping="Wrap" MaxWidth="420"/>
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="chev" Property="IsMouseOver" Value="True">
                    <Setter TargetName="chev" Property="Background" Value="#FF222226"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Карточка блока: название, счётчик включённых, прогресс -->
        <DataTemplate x:Key="GroupCardTemplate">
            <Border x:Name="card" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1"
                    CornerRadius="12" Padding="18,18,18,16" Margin="0,0,12,12" Cursor="Hand"
                    MouseLeftButtonUp="GroupCard_Click">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                        <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="Bold" Foreground="#FF78787E"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>
                    <TextBlock Text="{Binding Description}" Foreground="#FF78787E" FontSize="12.5"
                               TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,0" MinHeight="38"/>
                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid Grid.Column="0" Height="3" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="{Binding FillStar}"/>
                                <ColumnDefinition Width="{Binding RestStar}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="{DynamicResource Accent}" CornerRadius="2"/>
                            <Border Grid.Column="1" Background="#FF232327" CornerRadius="2"/>
                        </Grid>
                        <TextBlock Grid.Column="1" Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   FontSize="11" Foreground="#FF5A5A60" Margin="12,0,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="card" Property="IsMouseOver" Value="True">
                    <Setter TargetName="card" Property="Background" Value="#FF1A1A1C"/>
                    <Setter TargetName="card" Property="BorderBrush" Value="#FF3D3A2C"/>
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ===== ШАПКА ОКНА ===== -->
        <Grid Grid.Row="0" Background="#FF0B0B0C" MouseLeftButtonDown="Caption_Drag">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Border Width="10" Height="10" CornerRadius="2" Background="{DynamicResource Accent}"/>
                <TextBlock Text="AntiLag" FontSize="11.5" Foreground="#FF78787E" Margin="9,0,0,0"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" Click="Win_Minimize" ToolTip="Свернуть"/>
                <Button x:Name="MaxButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" Click="Win_Maximize" ToolTip="Развернуть"/>
                <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" Click="Win_Close" ToolTip="Закрыть"/>
            </StackPanel>
        </Grid>

        <!-- ===== ТЕЛО ===== -->
        <Grid Grid.Row="1" Margin="10,0,10,10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="10"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- ===== БОКОВАЯ ПАНЕЛЬ ===== -->
        <Border Grid.Column="0" Background="#FF111113" BorderBrush="#FF1D1D20" BorderThickness="1" CornerRadius="12">
            <DockPanel Margin="10,18,10,10">

                <!-- Логотип -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="10,0,10,20">
                    <Border Width="32" Height="32" CornerRadius="8" Background="{DynamicResource Accent}">
                        <TextBlock Text="&#xE945;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                   Foreground="{DynamicResource AccentFg}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="11,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ANTILAG" FontSize="15" FontWeight="Bold"/>
                        <TextBlock x:Name="VersionSide" Text="v0.0.0" FontSize="10" Foreground="#FF6A6A70" Margin="0,2,0,0"/>
                    </StackPanel>
                </StackPanel>

                <!-- Состояние таймера (низ панели) -->
                <Border DockPanel.Dock="Bottom" BorderBrush="#FF1D1D20" BorderThickness="0,1,0,0" Padding="12,14,12,6">
                    <StackPanel>
                        <Grid>
                            <TextBlock Text="TIMER" Foreground="#FF5A5A60" FontSize="9.5" FontWeight="Bold"/>
                            <TextBlock x:Name="TimerState" Text="" Foreground="{DynamicResource Accent}" FontSize="10"
                                       HorizontalAlignment="Right"/>
                        </Grid>
                        <TextBlock x:Name="TimerText" Text="—" FontSize="24" FontWeight="Bold" Margin="0,2,0,0"/>
                        <CheckBox x:Name="HoldTimerCheck" Content="Держать 0.5 ms" Foreground="#FFC8C8CC" FontSize="11.5"
                                  Margin="0,10,0,0" Checked="HoldTimer_Checked" Unchecked="HoldTimer_Unchecked"/>
                        <TextBlock x:Name="AdminText" Text="" Foreground="#FF55555B" FontSize="10"
                                   TextWrapping="Wrap" Margin="0,9,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Навигация: три группы, наполняются из вкладок Nav в коде -->
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="ТВИКИ" Style="{StaticResource NavGroupTitle}" Margin="12,0,12,8"/>
                        <ListBox x:Name="NavA" Style="{StaticResource NavList}"
                                 ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"/>
                        <TextBlock Text="ИНСТРУМЕНТЫ" Style="{StaticResource NavGroupTitle}"/>
                        <ListBox x:Name="NavB" Style="{StaticResource NavList}"
                                 ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"/>
                        <TextBlock Text="ПРИЛОЖЕНИЕ" Style="{StaticResource NavGroupTitle}"/>
                        <ListBox x:Name="NavC" Style="{StaticResource NavList}"
                                 ItemContainerStyle="{StaticResource NavItem}" SelectionChanged="NavList_SelectionChanged"/>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ===== КОНТЕНТ ===== -->
        <Border Grid.Column="2" Background="#FF111113" BorderBrush="#FF1D1D20" BorderThickness="1" CornerRadius="12">
        <Grid Margin="26,22,26,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка страницы -->
            <Grid Grid.Row="0" Margin="0,0,0,18">
                <TextBlock Text="{Binding SelectedItem.Header, ElementName=Nav}"
                           FontSize="25" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button x:Name="UpdateButton" Style="{StaticResource Primary}" Visibility="Collapsed"
                        HorizontalAlignment="Right" VerticalAlignment="Center"
                        Padding="12,6" FontSize="12" Click="Update_Click"/>
            </Grid>

            <!-- SelectedIndex обязателен: полоса вкладок скрыта, сам TabControl
                 первую вкладку в этом случае не выбирает и контент остаётся пустым. -->
            <TabControl x:Name="Nav" Grid.Row="1" Style="{StaticResource ShellTabs}" SelectedIndex="0"
                        SelectionChanged="Nav_SelectionChanged">

            <!-- БАЗОВОЕ — плоский список без блоков -->
            <TabItem Header="Базовое" Tag="&#xE945;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,14">
                        <TextBlock Text="Универсально и безопасно на любом ПК. Включено по умолчанию."
                                   Foreground="#FF78787E" FontSize="13" VerticalAlignment="Center"
                                   TextWrapping="Wrap" MaxWidth="520" HorizontalAlignment="Left"/>
                        <Button x:Name="BaseDescButton" Content="Показать описания" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Padding="13,7" FontSize="11.5"
                                Background="Transparent" BorderBrush="#FF2A2A2E" Tag="base" Click="ToggleAllDesc_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="TweaksItems" ItemTemplate="{StaticResource TweakTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ИГРОВЫЕ — блоки, внутри блока список твиков -->
            <TabItem Header="Игровые" Tag="&#xE7FC;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" MaxWidth="540">
                            <!-- Кнопка возврата: своя плашка, чтобы в неё было легко попасть -->
                            <Button x:Name="GameBack" Visibility="Collapsed" HorizontalAlignment="Left"
                                    Background="#FF161618" Padding="12,7" Margin="0,0,0,12" Click="GroupBack_Click">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                               FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                    <TextBlock Text="ВСЕ БЛОКИ" FontWeight="SemiBold" FontSize="11.5"/>
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="GameSubtitle" Foreground="#FF78787E" FontSize="13" TextWrapping="Wrap"
                                       LineHeight="19"
                                       Text="Опциональные твики. Выбери блок — внутри только то, что относится к нему."/>
                        </StackPanel>
                        <Button x:Name="GameDescButton" Content="Показать описания" HorizontalAlignment="Right"
                                VerticalAlignment="Center" Padding="13,7" FontSize="11.5" Visibility="Collapsed"
                                Background="Transparent" BorderBrush="#FF2A2A2E" Tag="game" Click="ToggleAllDesc_Click"/>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <Grid>
                            <ItemsControl x:Name="GameGroupsItems" ItemTemplate="{StaticResource GroupCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><UniformGrid Columns="2"/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                            <ItemsControl x:Name="GameTweaksItems" ItemTemplate="{StaticResource TweakTemplate}"
                                          Visibility="Collapsed"/>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- СЕТЬ -->
            <TabItem Header="Сеть" Tag="&#xE774;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- шапка раздела -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button x:Name="NetBack" Style="{StaticResource BackPill}" Visibility="Collapsed" Click="NetBack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="ВСЕ БЛОКИ" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="NetSubtitle" Foreground="#FF78787E" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                   Text="Диагностика и измерения — по блокам."/>
                    </StackPanel>

                    <!-- карточки блоков -->
                    <UniformGrid x:Name="NetCards" Grid.Row="1" Columns="2" VerticalAlignment="Top">
                        <Button Style="{StaticResource BlockCard}" Tag="state" Click="NetBlock_Click">
                            <StackPanel>
                                <TextBlock Text="Состояние сети" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                <TextBlock Text="Мониторинг задержки, потерь и джиттера в реальном времени."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BlockCard}" Tag="speed" Click="NetBlock_Click">
                            <StackPanel>
                                <TextBlock Text="Тест скорости" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                <TextBlock Text="Многопоточный замер: RU-сервер Selectel или Cloudflare."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BlockCard}" Tag="ping" Click="NetBlock_Click">
                            <StackPanel>
                                <TextBlock Text="Пинг и трассировка" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                <TextBlock Text="Ping, TCPing, маршрут до узла и разбор типовых ошибок."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- ===== Блок: состояние сети ===== -->
                    <Grid x:Name="NetPanelState" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <!-- Состояние соединения -->
                                <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Состояние соединения" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                                            <Button x:Name="MonitorButton" Content="Включить мониторинг" HorizontalAlignment="Right"
                                                    Padding="14,6" Click="MonitorButton_Click"/>
                                        </Grid>
                                        <Border x:Name="MonStatusPill" Background="#FF27272A" CornerRadius="6" Padding="12,7"
                                                Margin="0,12,0,0" HorizontalAlignment="Left">
                                            <TextBlock x:Name="MonStatus" Text="выключено" Foreground="#FFA1A1AA" FontWeight="SemiBold"/>
                                        </Border>
                                        <Grid Margin="0,16,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Задержка" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="MonLatency" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Потеря пакетов" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="MonLoss" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Скачки пинга" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="MonJitter" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="3">
                                                <TextBlock Text="Пики" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="MonPeaks" Text="—" FontSize="24" FontWeight="Bold"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Блок: тест скорости ===== -->
                    <Grid x:Name="NetPanelSpeed" Grid.Row="1" Visibility="Collapsed">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16">
                                    <StackPanel>
                                        <Grid>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Text="Тест скорости интернета" FontWeight="SemiBold" FontSize="15"/>
                                                <TextBlock x:Name="SpeedStatus" Text="многопоточный замер — точнее браузера" Foreground="#FFA1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <ComboBox x:Name="SpeedServerCombo" Width="160" Margin="0,0,8,0">
                                                    <ComboBoxItem Content="Selectel (RU)" Tag="selectel" IsSelected="True"/>
                                                    <ComboBoxItem Content="Cloudflare (глобал)" Tag="cf"/>
                                                </ComboBox>
                                                <Button x:Name="SpeedTestButton" Content="Запустить" Background="{DynamicResource Accent}" Padding="14,6" Click="SpeedTest_Click"/>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,18,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Загрузка" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="SpeedDown" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="1">
                                                <TextBlock Text="Отдача" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="SpeedUp" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Text="Пинг" Foreground="#FFA1A1AA" FontSize="11"/>
                                                <TextBlock x:Name="SpeedPing" Text="—" FontSize="28" FontWeight="Bold"/></StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </ScrollViewer>
                    </Grid>

                    <!-- ===== Блок: пинг и трассировка ===== -->
                    <Grid x:Name="NetPanelPing" Grid.Row="1" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                <StackPanel>
                                    <Grid>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="Тест:" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="#FFA1A1AA"/>
                                            <ComboBox x:Name="NetTestCombo" Width="150">
                                                <ComboBoxItem Content="Ping" Tag="ping" IsSelected="True"/>
                                                <ComboBoxItem Content="TCPing" Tag="tcp"/>
                                                <ComboBoxItem Content="Трассировка" Tag="trace"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <Button x:Name="NetStartButton" Content="Начать тест" HorizontalAlignment="Right"
                                                Background="{DynamicResource Accent}" Padding="14,6" Click="NetStart_Click"/>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="NetTarget" Grid.Column="0" Text="www.google.com" Padding="8,6"
                                                 Background="#FF09090B" Foreground="#FFFAFAFA" BorderBrush="#FF27272A"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                                            <TextBlock Text="порт:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#FFA1A1AA"/>
                                            <TextBox x:Name="NetPort" Text="443" Width="64" Padding="8,6"
                                                     Background="#FF09090B" Foreground="#FFFAFAFA" BorderBrush="#FF27272A"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <Border Grid.Row="1" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                <Grid>
                                    <TextBlock Text="Проверка сети на ошибки: шлюз, интернет, DNS, ошибки адаптера."
                                               Foreground="#FFA1A1AA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                    <Button x:Name="NetScanButton" Content="Сканировать сеть" HorizontalAlignment="Right"
                                            Padding="14,6" Click="NetScan_Click"/>
                                </Grid>
                            </Border>
                            <TextBox x:Name="NetOutput" Grid.Row="2" IsReadOnly="True" AcceptsReturn="True"
                                     VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"
                                     Background="#FF09090B" Foreground="#FFA1A1AA" BorderBrush="#FF27272A" Padding="10"/>
                        </Grid>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- DNS -->
            <TabItem Header="DNS" Tag="&#xE72E;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="DNS-серверы по отклику" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DnsResetButton" Content="Сбросить на DHCP" Padding="12,6" Margin="0,0,8,0" Click="DnsReset_Click"/>
                            <Button x:Name="DnsMeasureButton" Content="Обновить отклики" Background="{DynamicResource Accent}" Padding="12,6" Click="DnsMeasure_Click"/>
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="DnsCurrentText" Grid.Row="1" Foreground="#FFA1A1AA" Margin="2,0,0,8" Text="Текущий DNS: —"/>
                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DnsItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                                <TextBlock Text="{Binding Ips}" Foreground="#FFA1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding LatencyText}" Foreground="{Binding Accent}"
                                                       FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,14,0"/>
                                            <Button Grid.Column="2" Content="Выбрать" Tag="{Binding}" Click="DnsApply_Click"
                                                    Padding="14,6" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock Grid.Row="3" Foreground="#FFC9952E" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                               Text="Внимание: «Выбрать» меняет DNS на активном адаптере. Если DNS управляется роутером/VPN (OpenWrt, podkop) — может конфликтовать. «Сбросить на DHCP» вернёт как было."/>
                </Grid>
            </TabItem>

            <!-- DPC-МЕТР -->
            <TabItem Header="DPC-метр" Tag="&#xE916;">
                <StackPanel>
                    <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="18">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Живой замер задержки отклика" FontWeight="SemiBold"
                                           FontSize="15" VerticalAlignment="Center"/>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="MeterResetButton" Content="Сброс" Padding="12,6" Margin="0,0,8,0" Click="MeterReset_Click"/>
                                    <Button x:Name="MeterButton" Content="Включить" Padding="14,6" Click="MeterButton_Click"/>
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="сейчас" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="MeterCurrent" Text="—" FontSize="40" FontWeight="Bold"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="максимум (за 5 сек)" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="MeterMax" Text="—" FontSize="40" FontWeight="Bold"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#FFA1A1AA" FontSize="12" TextWrapping="Wrap" Margin="2,12,0,0"
                               Text="Цвет: зелёный &lt;500, жёлтый &lt;1000, красный &gt;1000 µs. Максимум — за последние 5 сек (старые спайки уходят), «Сброс» обнуляет. ВАЖНО: на простое ПК спайки это норма (ядра CPU уходят в сон) — показателен замер под нагрузкой / в игре."/>
                </StackPanel>
            </TabItem>

            <!-- УСКОРЕНИЕ -->
            <TabItem Header="Ускорение" Tag="&#xE90F;">
                <StackPanel>
                    <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16">
                        <StackPanel>
                            <Grid>
                                <TextBlock Text="Очистка оперативной памяти" FontWeight="SemiBold"
                                           FontSize="15" VerticalAlignment="Center"/>
                                <Button x:Name="CleanRamButton" Content="Очистить память" HorizontalAlignment="Right"
                                        Background="{DynamicResource Accent}" Padding="14,6" Click="CleanRam_Click"/>
                            </Grid>
                            <TextBlock x:Name="MemText" Text="—" Foreground="#FFA1A1AA" Margin="0,14,0,0"/>
                            <ProgressBar x:Name="MemBar" Height="12" Margin="0,8,0,0" Minimum="0" Maximum="100"
                                         Foreground="#FF6C9CE0" Background="#FF09090B" BorderThickness="0"/>
                            <TextBlock x:Name="MemResult" Text="" Foreground="{DynamicResource Accent}" Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                    <TextBlock Foreground="#FF71717A" FontSize="11" TextWrapping="Wrap" Margin="2,10,0,0"
                               Text="Очистка освобождает рабочие наборы процессов (working set) — временно высвобождает RAM. Безопасно: Windows сам подгрузит нужное обратно."/>
                </StackPanel>
            </TabItem>

            <!-- ДИАГНОСТИКА -->
            <TabItem Header="Диагностика" Tag="&#xE721;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Сканер находит, что можно оптимизировать именно на этом ПК."
                                   Foreground="#FFA1A1AA" VerticalAlignment="Center" TextWrapping="Wrap"/>
                        <Button x:Name="ScanButton" Content="Сканировать систему" HorizontalAlignment="Right"
                                Background="{DynamicResource Accent}" Padding="14,7" Click="ScanButton_Click"/>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="FindingsItems" ItemTemplate="{StaticResource FindingTemplate}"/>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ДРАЙВЕРЫ -->
            <TabItem Header="Драйверы" Tag="&#xE896;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock Text="Драйверы устройств" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="DriverWuButton" Content="Проверить Windows Update" Padding="12,6" Margin="0,0,8,0" Click="DriverWu_Click"/>
                            <Button x:Name="DriverScanButton" Content="Сканировать драйверы" Background="{DynamicResource Accent}" Padding="12,6" Click="DriverScan_Click"/>
                        </StackPanel>
                    </Grid>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="DriverItems">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Margin="0,0,0,8">
                                        <Grid>
                                            <Border Width="4" HorizontalAlignment="Left" Background="{Binding Accent}" CornerRadius="8,0,0,8"/>
                                            <Grid Margin="16,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Details}" Foreground="#FFA1A1AA" FontSize="11" Margin="0,2,0,0"/>
                                                </StackPanel>
                                                <Border Grid.Column="1" Background="#FF27272A" CornerRadius="4" Padding="7,2" Margin="8,0,8,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding StatusText}" FontSize="10" Foreground="{Binding Accent}"/>
                                                </Border>
                                                <Button Grid.Column="2" Content="{Binding ActionText}" Tag="{Binding ActionUrl}" Click="DriverLink_Click"
                                                        Padding="12,5" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <!-- Обновления из Windows Update (после проверки) -->
                    <Border x:Name="WuPanel" Grid.Row="2" Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,8,0,0" Visibility="Collapsed">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="WuStatus" Text="Windows Update" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <Button x:Name="WuInstallAll" Content="Установить все" HorizontalAlignment="Right"
                                        Background="{DynamicResource Accent}" Padding="12,6" Click="WuInstallAll_Click"/>
                            </Grid>
                            <ItemsControl x:Name="WuItems" Margin="0,10,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{Binding Title}" Foreground="#FFA1A1AA"
                                                       TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                            <Button Grid.Column="1" Content="Установить" Tag="{Binding}" Click="WuInstall_Click"
                                                    Padding="10,4" VerticalAlignment="Center"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <TextBlock Grid.Row="3" Foreground="#FFA1A1AA" FontSize="11" TextWrapping="Wrap" Margin="2,8,0,0"
                               Text="Сторонние драйверы: «Сайт» — офиц. загрузка вендора, «Найти» — поиск в интернете (самый надёжный способ обновления вручную). «Проверить Windows Update» найдёт и поставит проверенные драйверы из каталога Microsoft. Системные драйверы Microsoft в списке не показываем — они обновляются вместе с Windows."/>
                </Grid>
            </TabItem>

            <!-- О СИСТЕМЕ -->
            <TabItem Header="О системе" Tag="&#xE946;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,2,0,0">
                        <Grid Margin="0,0,0,10">
                            <TextBlock Text="Информация о системе" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            <Button x:Name="SysInfoButton" Content="Обновить" HorizontalAlignment="Right" Padding="12,6" Click="SysInfo_Click"/>
                        </Grid>

                        <UniformGrid Columns="2">
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Система" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysBoard" Text="—" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Процессор" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysCpu" Text="—" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Видеокарта" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysGpu" Text="—" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Память" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysRam" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Накопитель" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysStorage" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Windows" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysWin" Text="—" FontWeight="SemiBold" Margin="0,3,0,0" TextWrapping="Wrap"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Время работы" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysUptime" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,12" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Оценка ПК (WEI)" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="SysWei" Text="—" FontWeight="SemiBold" Margin="0,3,0,0"/></StackPanel></Border>
                        </UniformGrid>

                        <TextBlock Text="Нагрузка в реальном времени" FontWeight="SemiBold" FontSize="11" Foreground="#FF71717A" Margin="2,10,0,10"/>
                        <UniformGrid Columns="4">
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Процессор" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="TileCpu" Text="—" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Память" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="TileMem" Text="—" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Процессы" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="TileProc" Text="—" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/></StackPanel></Border>
                            <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16,14" Margin="0,0,10,10">
                                <StackPanel><TextBlock Text="Сеть (всего)" Foreground="#FFA1A1AA" FontSize="12"/>
                                    <TextBlock x:Name="TileNet" Text="—" FontSize="26" FontWeight="Bold" Margin="0,4,0,0"/>
                                    <TextBlock x:Name="TileNetSpeed" Text="" Foreground="#FFA1A1AA" FontSize="11" Margin="0,2,0,0"/></StackPanel></Border>
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ОФОРМЛЕНИЕ -->
            <TabItem Header="Оформление" Tag="&#xE790;">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- шапка раздела -->
                    <StackPanel Grid.Row="0" Margin="0,0,0,16">
                        <Button x:Name="LookBack" Style="{StaticResource BackPill}" Visibility="Collapsed" Click="LookBack_Click">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE72B;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                           FontSize="10" VerticalAlignment="Center" Margin="0,0,9,0"/>
                                <TextBlock Text="ВСЕ БЛОКИ" FontWeight="SemiBold" FontSize="11.5"/>
                            </StackPanel>
                        </Button>
                        <TextBlock x:Name="LookSubtitle" Foreground="#FF78787E" FontSize="13" TextWrapping="Wrap" LineHeight="19"
                                   Text="Внешний вид Windows: курсоры, стекло проводника и мелочи интерфейса."/>
                    </StackPanel>

                    <!-- карточки блоков -->
                    <UniformGrid x:Name="LookCards" Grid.Row="1" Columns="2" VerticalAlignment="Top">
                        <Button Style="{StaticResource BlockCard}" Tag="cursors" Click="LookBlock_Click">
                            <StackPanel>
                                <TextBlock Text="Курсоры" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                <TextBlock Text="Готовые схемы указателей — ставятся одним кликом. Свои паки тоже подхватываются."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BlockCard}" Tag="glass" Click="LookBlock_Click">
                            <StackPanel>
                                <TextBlock Text="Прозрачность проводника" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                <TextBlock Text="Стеклянный фон окон папок: размытие или заливка со своим цветом."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource BlockCard}" Tag="explorer" Click="LookBlock_Click">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="Проводник и меню" FontSize="15" FontWeight="Bold" Foreground="#FFF5F5F4"/>
                                    <TextBlock x:Name="LookExplorerStatus" Text="" FontSize="10" FontWeight="Bold"
                                               Foreground="#FF78787E" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Панель навигации, расширения файлов, контекстное меню."
                                           Foreground="#FF78787E" FontSize="12.5" TextWrapping="Wrap" LineHeight="19"
                                           Margin="0,8,0,0" MinHeight="38"/>
                                <TextBlock Text="&#xE76C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="11"
                                           Foreground="#FF5A5A60" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- ===== Блок: курсоры ===== -->
                    <ScrollViewer x:Name="LookPanelCursors" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Foreground="#FFA1A1AA" FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                                               HorizontalAlignment="Left"
                                               Text="Схема ставится одним кликом — без «ПКМ по Install.inf». Свои паки: положи папку с Install.inf в хранилище (кнопка ниже) и нажми «Обновить»."/>
                                    <Button x:Name="CursorRestore" Content="Вернуть системные" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Padding="12,6" Click="CursorRestore_Click"/>
                                </Grid>
                                <ItemsControl x:Name="CursorItems" Margin="0,14,0,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Tag="{Binding}" Click="CursorApply_Click" Margin="0,0,10,10"
                                                    Background="#FF09090B" HorizontalContentAlignment="Stretch" Padding="14,12">
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Author}" Foreground="#FF71717A" FontSize="11" Margin="0,3,0,0"/>
                                                </StackPanel>
                                            </Button>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid Margin="0,4,0,0">
                                    <TextBlock x:Name="CursorStatus" Foreground="#FFA1A1AA" FontSize="12" VerticalAlignment="Center"/>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button x:Name="CursorFolder" Content="Открыть хранилище" Padding="12,6" Margin="0,0,8,0" Click="CursorFolder_Click"/>
                                        <Button x:Name="CursorRefresh" Content="Обновить" Padding="12,6" Click="CursorRefresh_Click"/>
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Блок: прозрачность проводника ===== -->
                    <ScrollViewer x:Name="LookPanelGlass" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,10">
                            <StackPanel>
                                <Grid>
                                    <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                                        <TextBlock Text="Стеклянный фон окон папок" FontSize="14" FontWeight="SemiBold"/>
                                        <TextBlock Foreground="#FFA1A1AA" FontSize="12" TextWrapping="Wrap" MaxWidth="520"
                                                   HorizontalAlignment="Left" Margin="0,4,0,0" LineHeight="17"
                                                   Text="Назначает окнам проводника системную подложку через официальный API Windows — без внедрения в explorer.exe, поэтому безопасно и не ловится антивирусами."/>
                                    </StackPanel>
                                    <CheckBox x:Name="GlassCheck" HorizontalAlignment="Right" VerticalAlignment="Center"
                                              Checked="Glass_Checked" Unchecked="Glass_Unchecked"/>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <RadioButton x:Name="GlassBlur" Style="{StaticResource Seg}" GroupName="glass" Tag="10" Content="Размытие" IsChecked="True" Checked="GlassKind_Checked"/>
                                    <RadioButton x:Name="GlassTint" Style="{StaticResource Seg}" GroupName="glass" Tag="11" Content="Заливка" Checked="GlassKind_Checked"/>
                                    <RadioButton x:Name="GlassMica" Style="{StaticResource Seg}" GroupName="glass" Tag="2" Content="Слюда" Checked="GlassKind_Checked"/>
                                    <RadioButton x:Name="GlassAcrylic" Style="{StaticResource Seg}" GroupName="glass" Tag="3" Content="Акрил" Checked="GlassKind_Checked"/>
                                    <RadioButton x:Name="GlassTabbed" Style="{StaticResource Seg}" GroupName="glass" Tag="4" Content="Вкладки" Checked="GlassKind_Checked"/>
                                </StackPanel>

                                <!-- Свой цвет и прозрачность (для «Размытия» и «Заливки») -->
                                <Grid x:Name="GlassTintRow" Margin="0,16,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Цвет" Foreground="#FFA1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Button Grid.Column="1" x:Name="GlassColorButton" Width="34" Height="34" Padding="0"
                                            Click="GlassColor_Click" VerticalAlignment="Center" Margin="0,0,20,0"/>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Прозрачность" Foreground="#FFA1A1AA" FontSize="12"/>
                                        <Slider x:Name="GlassAlphaSlider" Minimum="0" Maximum="255" Margin="0,6,0,0"
                                                ValueChanged="GlassAlpha_Changed"/>
                                    </StackPanel>
                                    <TextBlock Grid.Column="3" x:Name="GlassAlphaText" Text="—" Foreground="#FFFAFAFA"
                                               FontWeight="SemiBold" VerticalAlignment="Bottom" Margin="12,0,0,0" MinWidth="42" TextAlignment="Right"/>
                                </Grid>

                                <TextBlock x:Name="GlassHint" Foreground="#FF71717A" FontSize="11" TextWrapping="Wrap" Margin="2,12,0,0"
                                           Text="Открой любую папку, чтобы увидеть эффект. «Размытие» и «Заливка» используют твой цвет и прозрачность; «Слюда», «Акрил» и «Вкладки» — системные, цвет там задаёт Windows."/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                    </ScrollViewer>

                    <!-- ===== Блок: проводник и меню ===== -->
                    <ScrollViewer x:Name="LookPanelExplorer" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl x:Name="LookTweaksItems" ItemTemplate="{StaticResource TweakTemplate}"/>
                            <TextBlock Foreground="#FF67676E" FontSize="11" TextWrapping="Wrap" Margin="2,4,0,0" LineHeight="17"
                                       Text="Эти переключатели меняют только внешний вид и применяются кнопкой «Применить». Проводник при этом перезапустится — открытые окна папок закроются."/>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- НАСТРОЙКИ -->
            <TabItem Header="Настройки" Tag="&#xE713;">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Поведение приложения" FontWeight="SemiBold" FontSize="11" Foreground="#FF71717A" Margin="2,0,0,10"/>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                            <StackPanel>
                                <CheckBox x:Name="AutoStartCheck" Content="Запуск при старте Windows"
                                          Foreground="#FFFAFAFA" Checked="AutoStart_Checked" Unchecked="AutoStart_Unchecked"/>
                                <TextBlock Foreground="#FFA1A1AA" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,12"
                                           Text="Чтобы держать таймер 0.5 ms всегда, программа должна быть запущена. С автозапуском это происходит само."/>
                                <CheckBox x:Name="MinTrayCheck" Content="Сворачивать в трей при закрытии"
                                          Foreground="#FFFAFAFA" Checked="MinTray_Checked" Unchecked="MinTray_Unchecked"/>
                                <TextBlock Foreground="#FFA1A1AA" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,12"
                                           Text="Крестик сворачивает в трей (значок у часов) — программа продолжает держать 0.5 ms в фоне. Выход — через меню трея."/>
                                <CheckBox x:Name="AutoUpdateCheck" Content="Загружать обновления автоматически"
                                          Foreground="#FFFAFAFA" Checked="AutoUpdate_Checked" Unchecked="AutoUpdate_Unchecked"/>
                                <TextBlock Foreground="#FFA1A1AA" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,12"
                                           Text="Новая версия скачивается в фоне, а установка — по кнопке вверху, чтобы программа не перезапустилась во время игры."/>
                                <CheckBox x:Name="DenseCheck" Content="Плотные строки"
                                          Foreground="#FFFAFAFA" Checked="Dense_Checked" Unchecked="Dense_Unchecked"/>
                                <TextBlock Foreground="#FFA1A1AA" FontSize="11" TextWrapping="Wrap" Margin="22,4,0,0"
                                           Text="Уменьшает отступы в списках твиков — на экран помещается больше строк."/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Размер окна" FontWeight="SemiBold" FontSize="11" Foreground="#FF71717A" Margin="2,12,0,10"/>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,8">
                            <Grid>
                                <TextBlock Text="Выбери удобный размер окна" Foreground="#FFA1A1AA" VerticalAlignment="Center"/>
                                <ComboBox x:Name="WindowSizeCombo" HorizontalAlignment="Right" Width="220"
                                          SelectionChanged="WindowSizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Компактный (960 × 700)" Tag="960,700"/>
                                    <ComboBoxItem Content="Средний (1020 × 780)" Tag="1020,780" IsSelected="True"/>
                                    <ComboBoxItem Content="Большой (1220 × 900)" Tag="1220,900"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <TextBlock Text="Цвет акцента" FontWeight="SemiBold" FontSize="11" Foreground="#FF71717A" Margin="2,12,0,10"/>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <TextBlock Foreground="#FFA1A1AA" FontSize="12" TextWrapping="Wrap"
                                           Text="Цвет кнопок, тумблеров и активного пункта меню. Применяется сразу."/>
                                <StackPanel x:Name="SwatchRow" Orientation="Horizontal" Margin="0,14,0,0"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="О программе" FontWeight="SemiBold" FontSize="11" Foreground="#FF71717A" Margin="2,12,0,10"/>
                        <Border Background="#FF161618" BorderBrush="#FF232327" BorderThickness="1" CornerRadius="12" Padding="14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <TextBlock Text="AntiLag" FontWeight="Bold" FontSize="16"/>
                                    <TextBlock x:Name="VersionAbout" Text="v0.0.0" Foreground="#FFA1A1AA" FontSize="12" VerticalAlignment="Bottom" Margin="6,0,0,2"/>
                                </StackPanel>
                                <TextBlock Foreground="#FFA1A1AA" TextWrapping="Wrap"
                                           Text="Снижает задержки и держит таймер 0.5 ms. Лечит причину, диагностирует железо и сеть, откатывает изменения в один клик. Работает строго в user-mode (безопасно для анти-читов)."/>
                                <TextBlock Margin="0,10,0,0" TextWrapping="Wrap">
                                    <Run Text="Автор: " Foreground="#FFA1A1AA"/><Run Text="AxelNerv" Foreground="{DynamicResource Accent}" FontWeight="SemiBold"/>
                                    <LineBreak/>
                                    <Run Text="Создано с Claude Code" Foreground="#FFA1A1AA"/>
                                </TextBlock>
                                <TextBlock x:Name="BackupPathText" Foreground="#FF71717A" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                <Grid Margin="0,12,0,0">
                                    <TextBlock Foreground="#FF71717A" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center"
                                               MaxWidth="380" HorizontalAlignment="Left"
                                               Text="Если что-то не сработало — подробности пишутся в журнал."/>
                                    <Button Content="Открыть журнал" HorizontalAlignment="Right" Padding="12,6"
                                            FontSize="11.5" Click="OpenLog_Click"/>
                                </Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

            <!-- Глобальная панель действий -->
            <StackPanel Grid.Row="2" Margin="0,18,0,0">
                <Border x:Name="RebootBox" Background="#FF2A1F05" BorderBrush="#FF5C4405" BorderThickness="1"
                        CornerRadius="10" Padding="14,10" Margin="0,0,0,12" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                                   Foreground="{DynamicResource Accent}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBlock Foreground="{DynamicResource Accent}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   Text="Нужна перезагрузка, чтобы изменения вступили в силу."/>
                    </StackPanel>
                </Border>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="PendingText" Text="" Foreground="#FF9C9CA3"
                               FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" x:Name="UndoButton" Content="Откатить всё"
                            Padding="16,10" Click="UndoButton_Click"/>
                    <Button Grid.Column="3" x:Name="ApplyButton" Content="Применить"
                            Style="{StaticResource Primary}" Padding="24,10" Click="ApplyButton_Click"/>
                </Grid>
            </StackPanel>
        </Grid>
        </Border>
        </Grid>
    </Grid>
</Window>
